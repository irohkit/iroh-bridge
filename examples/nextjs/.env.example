# Optional: override the gateways from iroh.config.ts, as JSON, e.g.
# NEXT_PUBLIC_IROH_BACKENDS={"https://api.demo":{"endpointIds":["<id1>","<id2>"]},"https://files.demo":"<id3>"}
NEXT_PUBLIC_IROH_BACKENDS=
# Your own relay, if the gateways use one (default: n0's public relays)
NEXT_PUBLIC_IROH_RELAY_URL=
# Its token, if it requires one. Server-only: app/api/relay-token serves it to the page at runtime.
IROH_RELAY_TOKEN=
# Older fallback, used only when IROH_RELAY_TOKEN is unset: baked into the page, readable by anyone.
NEXT_PUBLIC_IROH_RELAY_TOKEN=
