# Optional: override the gateways from iroh.config.ts, as JSON, e.g.
# NEXT_PUBLIC_IROH_BACKENDS={"https://api.demo":{"endpointIds":["<id1>","<id2>"]},"https://files.demo":"<id3>"}
NEXT_PUBLIC_IROH_BACKENDS=
# Relay the gateways use (default: the demo's self-hosted relay), and its token if it requires one
NEXT_PUBLIC_IROH_RELAY_URL=
NEXT_PUBLIC_IROH_RELAY_TOKEN=
