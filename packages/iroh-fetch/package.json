{
  "name": "iroh-fetch",
  "version": "0.1.1",
  "description": "fetch() over iroh: reach an HTTP backend behind any NAT from browsers and Node.js",
  "license": "MIT",
  "author": "poommin2543",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irohkit/iroh-bridge.git",
    "directory": "packages/iroh-fetch"
  },
  "homepage": "https://github.com/irohkit/iroh-bridge#readme",
  "bugs": {
    "url": "https://github.com/irohkit/iroh-bridge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": "./src/node.js",
      "default": "./src/browser.js"
    }
  },
  "files": [
    "src",
    "wasm/web_client.js",
    "wasm/web_client.d.ts",
    "wasm/web_client_bg.wasm",
    "wasm/web_client_bg.wasm.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "build": "../../scripts/build-wasm.sh",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "iroh",
    "p2p",
    "nat",
    "nat-traversal",
    "fetch",
    "websocket",
    "sse",
    "wasm",
    "tunnel"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
